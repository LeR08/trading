# ===================================
# KRAKEN API CREDENTIALS
# ===================================
# Créer vos clés API sur https://www.kraken.com
# Settings -> API -> Generate New Key
# Permissions requises: Query Funds, Create & Modify Orders, Query Orders
KRK_KEY=your_api_key_here
KRK_SECRET=your_api_secret_here

# ===================================
# TRADING CONFIGURATION
# ===================================
# Paire de trading (XBTUSD pour BTC/USD, XBTEUR pour BTC/EUR)
PAIR=XBTUSD

# Effet de levier (1-5 pour BTC sur Kraken)
# ATTENTION: Levier x10 amplifie les gains ET les pertes
LEVERAGE=10

# Risque par trade (0.02 = 2% du capital par trade)
# Avec levier x10, recommandé de baisser à 1-2%
RISK_PER_TRADE=0.02

# Exposition maximale totale (0.10 = 10% du capital)
MAX_TOTAL_EXPOSURE=0.10

# Slippage estimé en % (0.002 = 0.2%)
SLIPPAGE_PCT=0.002

# ===================================
# STRATEGY
# ===================================
# Stratégie à utiliser: trend_following | mean_reversion | breakout
STRATEGY=trend_following

# ===================================
# RISK MANAGEMENT
# ===================================
# Drawdown maximum avant arrêt (0.15 = 15%)
MAX_DRAWDOWN=0.15

# Perte journalière maximum (0.05 = 5%)
MAX_DAILY_LOSS_PCT=0.05

# Nombre maximum de pertes consécutives
MAX_CONSECUTIVE_LOSSES=5

# ===================================
# EXECUTION
# ===================================
# Nombre maximum de tentatives pour placer un ordre
MAX_RETRIES=5

# Intervalle entre cycles en secondes (300 = 5 minutes)
INTERVAL_SECONDS=300

# ===================================
# MODE
# ===================================
# Mode dry-run: true = simulation, false = réel
# TOUJOURS commencer en dry-run!
DRY_RUN=true

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=INFO
