# ====================================================================
# CONFIGURATION KRAKEN TRADING BOT PROFESSIONNEL MULTI-TIMEFRAME
# ====================================================================

# ========================
# KRAKEN API CREDENTIALS
# ========================
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# ========================
# WEBHOOK CONFIGURATION
# ========================
# URL du webhook pour recevoir les signaux de trading
WEBHOOK_URL=https://votre-webhook.com/trading-signals

# ========================
# TRADING PARAMETERS
# ========================
# Paire de trading (BTC/USD)
TRADING_PAIR=XXBTZUSD

# Levier (x10 pour marge maximale)
LEVERAGE=10

# Take Profit en pourcentage
TAKE_PROFIT_PERCENT=5.0

# Stop Loss en pourcentage
STOP_LOSS_PERCENT=2.0

# ========================
# BOT SETTINGS
# ========================
# Mode de trading: true pour mode fictif (simulation), false pour mode réel
PAPER_TRADING=true

# Intervalle de vérification en secondes
CHECK_INTERVAL=60

# Taille minimale d'ordre (BTC)
MIN_ORDER_SIZE=0.001

# Taille maximale de position (BTC)
MAX_POSITION_SIZE=0.1

# ========================
# RISK MANAGEMENT
# ========================
# Perte maximale journalière en pourcentage
MAX_DAILY_LOSS_PERCENT=10.0

# Nombre maximum de positions ouvertes
MAX_OPEN_POSITIONS=3

# Score de confiance minimum pour trader (0-100)
MIN_CONFIDENCE_SCORE=70

# ========================
# MULTI-TIMEFRAME ANALYSIS
# ========================
# Timeframes à analyser (séparées par des virgules)
# Disponibles: 1, 5, 15, 30, 60, 240, 1440, 10080, 21600
TIMEFRAMES=5,15,60,240,1440

# Poids de chaque timeframe pour le score de confiance
# Format: timeframe:poids (séparés par des virgules)
TIMEFRAME_WEIGHTS=1:1,5:2,15:3,30:4,60:5,240:6,1440:7,10080:5,21600:3
