# ===================================
# KRAKEN API CREDENTIALS
# ===================================
# Créer vos clés API sur https://www.kraken.com
# Settings -> API -> Generate New Key
# Permissions requises: Query Funds, Create & Modify Orders, Query Orders
KRK_KEY=your_api_key_here
KRK_SECRET=your_api_secret_here

# ===================================
# TRADING CONFIGURATION
# ===================================
# Paire de trading (XBTUSD pour BTC/USD, XBTEUR pour BTC/EUR)
PAIR=XBTUSD

# Effet de levier (1-5 pour BTC sur Kraken, mais peut aller jusqu'à 10x selon compte)
# ATTENTION: Levier x10 amplifie les gains ET les pertes
# Avec 26$, vous pouvez contrôler jusqu'à 260$ de BTC
LEVERAGE=10

# Risque par trade (0.025 = 2.5% du capital par trade)
# Avec 26$ et 2.5% de risque = 0.65$ risqué par trade
# MODE AGRESSIF pour testing avec 12 indicateurs et seuil 66%
RISK_PER_TRADE=0.025

# Exposition maximale totale (0.30 = 30% du capital)
# MODE AGRESSIF: Permet de prendre plusieurs positions simultanées
MAX_TOTAL_EXPOSURE=0.30

# Slippage estimé en % (0.002 = 0.2%)
SLIPPAGE_PCT=0.002

# ===================================
# STRATEGY
# ===================================
# Stratégie à utiliser: trend_following | mean_reversion | breakout
STRATEGY=trend_following

# ===================================
# RISK MANAGEMENT
# ===================================
# Drawdown maximum avant arrêt (0.20 = 20%)
# Avec petit capital, on accepte un drawdown un peu plus élevé
MAX_DRAWDOWN=0.20

# Perte journalière maximum (0.05 = 5%)
# MODE AGRESSIF: Limite à 5% de perte par jour = 1.30$ max
MAX_DAILY_LOSS_PCT=0.05

# Nombre maximum de pertes consécutives
MAX_CONSECUTIVE_LOSSES=3

# ===================================
# EXECUTION
# ===================================
# Nombre maximum de tentatives pour placer un ordre
MAX_RETRIES=5

# Intervalle entre cycles en secondes (300 = 5 minutes)
# Vous pouvez réduire à 60s pour plus de réactivité avec petit capital
INTERVAL_SECONDS=300

# ===================================
# MODE
# ===================================
# Mode dry-run: true = simulation, false = réel
# Commencer en dry-run pour tester!
DRY_RUN=true

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=INFO
